{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soplos-appimage-manager",
  "version": "3.0.0-6-beta",
  "identifier": "org.soplos.appimagemanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soplos AppImage Manager",
        "width": 720,
        "height": 572,
        "minWidth": 560,
        "minHeight": 432,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "publisher": "Sergi Perich",
    "homepage": "https://soplos.org",
    "copyright": "Copyright © 2026 Sergi Perich",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Manage and integrate AppImage applications",
    "longDescription": "Integrates AppImage applications into the Soplos Linux desktop. Moves AppImages to ~/AppImages/, extracts icons and metadata, creates .desktop entries, and checks GitHub, GitLab and Codeberg for updates.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "recommends": ["p7zip-full", "binutils", "desktop-file-utils", "libgtk-3-bin"],
        "changelog": "../CHANGELOG.md",
        "desktopTemplate": "resources/debian/soplos-appimage-manager.desktop.hbs",
        "files": {
          "/usr/share/metainfo/org.soplos.appimagemanager.metainfo.xml": "resources/appstream/org.soplos.appimagemanager.metainfo.xml",
          "/usr/share/doc/soplos-appimage-manager/copyright": "resources/debian/copyright",
          "/usr/share/doc/soplos-appimage-manager/screenshots/screenshot01.png": "resources/screenshots/screenshot01.png",
          "/usr/share/doc/soplos-appimage-manager/screenshots/screenshot02.png": "resources/screenshots/screenshot02.png",
          "/usr/share/doc/soplos-appimage-manager/screenshots/screenshot03.png": "resources/screenshots/screenshot03.png",
          "/usr/share/doc/soplos-appimage-manager/screenshots/screenshot04.png": "resources/screenshots/screenshot04.png",
          "/usr/share/doc/soplos-appimage-manager/screenshots/screenshot05.png": "resources/screenshots/screenshot05.png",
          "/usr/share/man/man1/soplos-appimage-manager.1.gz": "resources/docs/soplos-appimage-manager.1.gz"
        }
      }
    }
  }
}
